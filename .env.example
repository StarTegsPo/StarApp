# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Публичный HTTPS-адрес, где доступен Mini App (нужен Telegram для кнопки WebApp)
PUBLIC_URL=https://your-domain.example
# Порт HTTP-сервера (API + статика Mini App)
PORT=3000
# Путь к файлу базы SQLite
DB_PATH=./data/starapp.db
# ID администраторов через запятую (могут добавлять товары и отвечать в поддержке)
ADMIN_IDS=
# Чат (группа) администраторов, куда пересылаются обращения в поддержку
SUPPORT_CHAT_ID=
# Как часто снимать число подписчиков каналов, в минутах
CHANNEL_SNAPSHOT_MINUTES=60
# Только для локальной разработки: открыть Mini App в браузере от имени этого пользователя
DEV_USER_ID=
# Сколько ⭐ получает пригласивший, когда приглашённый друг совершит первую оплату (0 — выключить)
REFERRAL_BONUS=10
# Сервисы экосистемы на вкладке StarTegs (JSON). Пусто — список по умолчанию из src/services/eco/index.js
# Пример: [{"icon":"⭐","title":"StarTegs","bot":"StarTegsEcosistem_bot","desc":"Удалённые сообщения"},{"icon":"📊","title":"Аналитика","tab":"analytics"}]
ECO_BOTS=
