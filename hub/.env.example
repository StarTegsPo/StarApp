# Токен бота от @BotFather (можно взять токен старого @StarTegsEcosistem_bot — тогда приложение подключится само)
BOT_TOKEN=
# Твой числовой Telegram ID (админка: /admin, /broadcast)
ADMIN_ID=
# Адрес HTTPS (скрипт termux/hub.sh ставит его сам через cloudflared)
PUBLIC_URL=
PORT=8080
# Нейросеть: достаточно одного ключа. OpenRouter — бесплатно.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
# Вопросов к нейросети в день на человека
AI_DAY_LIMIT=40
