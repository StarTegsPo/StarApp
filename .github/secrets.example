# GitHub Secrets для сборки StarTegs APK
# Настройте в Settings → Secrets and variables → Actions → New repository secret

# ОБЯЗАТЕЛЬНЫЕ (получите на https://my.telegram.org → API development tools)
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# ЖЕЛАТЕЛЬНЫЕ (для подписи своим ключом, иначе — тестовый ключ Telegram)
# Генерация ключа (один раз):
# keytool -genkeypair -v -keystore startegs.keystore -alias startegs -keyalg RSA -keysize 2048 -validity 10000
# base64 -w0 startegs.keystore  → вставьте в KEYSTORE_BASE64
KEYSTORE_BASE64=
KEYSTORE_PASSWORD=